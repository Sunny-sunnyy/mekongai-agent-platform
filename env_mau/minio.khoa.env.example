# Cap khoa MinIO noi bo (S3 gia lap cho upload file va Temporal payload)
# MINIO_ROOT_* va AWS_* dung chung mot cap gia tri; tu sinh bang scripts_sach/khoi_tao_lan_dau.sh
MINIO_ROOT_USER=<auto-generated-alphanumeric-user>
MINIO_ROOT_PASSWORD=<auto-generated-alphanumeric-password>
AWS_ACCESS_KEY_ID=<same-as-MINIO_ROOT_USER>
AWS_SECRET_ACCESS_KEY=<same-as-MINIO_ROOT_PASSWORD>
