# Cau hinh an toan cho mcp-fastapi va mcp-servers
ENVIRONMENT=local
HOST_BASE_URL=http://mcp-servers:8120
AGENTIC_BACKEND_URL=http://ab-api:80
CAPITOL_BASE_URL=http://ab-api:80
PLATFORM_API_BASE_URL=http://platform-api:80
PLATFORM_FRONTEND_URL=http://127.0.0.1:18400
DYNAMODB_ENDPOINT_URL=http://dynamodb:8000
MCP_FEEDBACK_DYNAMODB_TABLE=mcp-tool-feedback
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localfakekey1234
AWS_SECRET_ACCESS_KEY=localfakesecret1234
AWS_EC2_METADATA_DISABLED=true

# Metadata cho nginx envsubst trong mcp-servers
IMAGE_URI=capitol-local/mcp-servers:release-3.16.0
APP_VERSION=release-3.16.0
GIT_SHORT_SHA=local
GIT_BRANCH_NAME=local

# Tat cac bien tuy chon de supervisord khong loi format string
QDRANT_URL=http://127.0.0.1:9
QDRANT_API_KEY=
QDRANT_CLUSTER_PROFILES=
QDRANT_DEFAULT_CLUSTER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CEREBRAS_API_KEY=
