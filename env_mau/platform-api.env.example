# Cau hinh an toan cho platform-api (chay cuc bo voi dynamodb-local)
ENVIRONMENT=local
INTERNAL_ROUTES_AUTH_ENABLED=false

# Tat gui loi / telemetry ra ngoai Capitol
SENTRY_ENABLED=false
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_DESTINATION=LOCAL_GOODIES_JAEGER
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4317
CORALOGIX_SEND_DATA_KEY=

# DynamoDB local va khoa AWS gia (chi chu va so)
DYNAMODB_ENDPOINT_URL=http://dynamodb:8000
DYNAMODB_TABLE_PREFIX=local
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localfakekey1234
AWS_SECRET_ACCESS_KEY=localfakesecret1234
AWS_EC2_METADATA_DISABLED=true

# Tro cac dich vu khong dung ve cong dong
OPENSEARCH_URL=http://127.0.0.1:9
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
CLJ_PG_WRAPPER_BASE_URL=http://127.0.0.1:9
CLOJURE_BASE_URL=http://127.0.0.1:9

# Dich vu noi bo trong mang compose
MCP_FASTAPI_BASE_URL=http://mcp-fastapi:80
AGENTIC_BACKEND_BASE_URL=http://ab-api:80
SEND_REAL_EMAILS=false
