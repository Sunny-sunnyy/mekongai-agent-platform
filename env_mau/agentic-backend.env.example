# Cau hinh an toan cho agentic-backend (khong chua khoa that)
ENVIRONMENT=local
AUTH_ENABLED=false
ACCESS_CONTROL_ENABLED=false
PLATFORM_API_BASE_URL=http://platform-api:80

# PostgreSQL & Redis trong mang Docker noi bo
AGENTIC_DB_URL=postgresql+asyncpg://capitol:chi_dung_tren_may@postgres:5432/agentic
AGENTIC_DB_URL_SYNC=postgresql+psycopg://capitol:chi_dung_tren_may@postgres:5432/agentic
PLATFORM_DB_URL=postgresql+asyncpg://capitol:chi_dung_tren_may@postgres:5432/agentic
REDIS_URL=redis://redis-agentic-backend:6379
USE_TEMPORAL=false

# Tat gui loi / telemetry ra ngoai Capitol
SENTRY_ENABLED=false
SENTRY_DSN=
OTEL_ENABLED=false
OTEL_DESTINATION=LOCAL_GOODIES_JAEGER
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel:4317
TELEMETRY_EXPORT_OTLP_ENDPOINT=http://otel:4318
CORALOGIX_SEND_DATA_KEY=
LANGFUSE_ENABLED=false
POSTHOG_API_KEY=

# Tro cac dich vu khong dung ve cong dong
OPENSEARCH_URL=http://127.0.0.1:9
COMPOSIO_API_BASE=http://127.0.0.1:9

# Khoa / AWS de trong (khoa that dat o agentic-backend.khoa.env hoac cong_ai)
AWS_EC2_METADATA_DISABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_TOKEN=
E2B_API_KEY=
SERPAPI_KEY=
DIFFBOT_KEY=

# Gioi han an toan cho Operator & Temporal payload
A2A_RUN_TOOL_MOUNT_ENABLED=false
A2A_TOOL_CATALOG_ENABLED=false
HITL_REVIEW_DIGEST_MODEL=gpt-6-luna
CONTEXT_COMPACTION_MODEL=claude-opus-4-7
TEMPORAL_PAYLOAD_BUCKET=capitol-chay-thu-temporal-payload
TEMPORAL_PAYLOAD_REGION=us-east-1
