# MCP Servers Reverse Proxy Configuration

worker_processes 1;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';

    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;

    # Compression settings
    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_buffers 16 8k;
    gzip_http_version 1.1;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    server {
        listen 8120;
        server_name localhost;

        # Liveness: nginx itself is responding (container alive)
        location /health {
            access_log off;
            add_header Content-Type application/json;
            return 200 '{"status": "ok"}';
        }

        # Version metadata. Values are interpolated at container start by
        # envsubst (see supervisord nginx program); the static nginx.conf is
        # rendered from nginx.conf.template. Mirrors the mcp-fastapi /version
        # shape so platform-api /health/services can surface the running tag.
        location = /version {
            access_log off;
            add_header Content-Type application/json;
            return 200 '{"app_version": "${APP_VERSION}", "git_branch_name": "${GIT_BRANCH_NAME}", "git_short_sha": "${GIT_SHORT_SHA}", "image_uri": "${IMAGE_URI}"}';
        }

        # Readiness: workflow-builder-server is up.
        # Any HTTP response from the backend proves it's listening.
        # Connection failure → nginx 502 → K8s marks pod not-ready.
        location /ready {
            access_log off;
            proxy_pass http://127.0.0.1:8020/;
            proxy_connect_timeout 3;
            proxy_read_timeout 3;
            proxy_intercept_errors on;
            error_page 400 401 403 404 405 500 = @backend_alive;
        }

        location @backend_alive {
            add_header Content-Type application/json always;
            return 200 '{"status": "ready"}';
        }

