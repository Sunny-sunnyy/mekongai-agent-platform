# Image hop ban 3 — sandbox-py:v3 = sandbox-py:v2 + Node.js 20 + pptxgenjs / docx / sharp + LibreOffice + pandoc + defusedxml
# Dung khong mang tu thu muc da tai o buoc Dockerfile.v3_tai (/tmp/sandbox_khoa_goi_v3):
#   docker build --network none --build-context banh=/tmp/sandbox_khoa_goi_v3 -f v3/Dockerfile.v3 -t sandbox-py:v3 v3
FROM python:3.12-slim@sha256:e695ab189fa2d082b1c61c69a6b888a5adeca61ceeccad107b1ed2a125721a9e AS pip_goc

FROM sandbox-py:v2
USER 0:0
COPY goi_khoa_v3.txt /chay/goi_khoa_v3.txt
RUN --mount=type=bind,from=banh,target=/banh \
    --mount=type=bind,from=pip_goc,source=/usr/local/lib/python3.12/site-packages,target=/pip_tam \
    cd /banh && sha256sum -c --quiet SHA256SUMS \
 && for luot in 1 2 3 4; do dpkg -i /banh/debs/*.deb > /tmp/dpkg_luot.log 2>&1 && break; echo "dpkg luot $luot con loi (pre-depends)"; done \
 && for f in /banh/debs/*.deb; do p=$(dpkg-deb -f "$f" Package); \
      [ "$(dpkg-query -W -f='${Status}' "$p" 2>/dev/null)" = "install ok installed" ] || { echo "CHUA CAI: $p"; exit 1; }; done \
 && [ -z "$(dpkg --audit)" ] \
 && tar -xzf /banh/node_modules.tgz -C /usr/lib \
 && PYTHONPATH=/pip_tam python -m pip install --no-cache-dir --no-index --find-links /banh/wheels --require-hashes --only-binary=:all: --no-deps \
        -r /chay/goi_khoa_v3.txt \
 && cp /banh/package-lock.json /chay/package-lock.v3.json \
 && ! python -c "import pip" 2>/dev/null \
 && ! command -v npm \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/* /root/.cache /root/.npm \
 && find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} +
ENV NODE_PATH=/usr/lib/node_modules SAL_USE_VCLPLUGIN=svp
USER 65534:65534
WORKDIR /out
