# Image hop ban 2 — sandbox-py:v2 = sandbox-py:v1 + python-pptx / python-docx
# Dung khong mang tu thu muc wheel (/tmp/sandbox_khoa_goi_v2):
#   docker build --network none --build-context banh=/tmp/sandbox_khoa_goi_v2 -f Dockerfile.v2 -t sandbox-py:v2 .
FROM python:3.12-slim@sha256:e695ab189fa2d082b1c61c69a6b888a5adeca61ceeccad107b1ed2a125721a9e AS pip_goc

FROM sandbox-py:v1
USER 0:0
COPY goi_khoa_v2.txt /chay/goi_khoa_v2.txt
RUN --mount=type=bind,from=banh,target=/banh \
    --mount=type=bind,from=pip_goc,source=/usr/local/lib/python3.12/site-packages,target=/pip_tam \
    PYTHONPATH=/pip_tam python -m pip install --no-cache-dir --no-index --find-links /banh --require-hashes --only-binary=:all: --no-deps \
        -r /chay/goi_khoa_v2.txt \
 && PYTHONPATH=/pip_tam python -m pip freeze > /chay/goi_v2.txt \
 && ! python -c "import pip" 2>/dev/null \
 && rm -rf /root/.cache \
 && find / -xdev -type f \( -perm -4000 -o -perm -2000 \) -exec chmod a-s {} +
USER 65534:65534
WORKDIR /out
